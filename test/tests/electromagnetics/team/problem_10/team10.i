# TEAM Problem 10: steel plates around a coil
# ===========================================
#
# A coil sits between two steel channels with a steel plate through its middle.
# The coil current rises as I(t) = Im (1 - exp(-t / tau)), and the benchmark asks
# for the average flux density through three sections of the steel (S1, S2, S3)
# against time. The steel is conducting and saturates, so the problem is both
# transient (eddy currents) and non-linear (B-H curve).
#
# Formulation
# -----------
# Magnetic vector potential A in H(curl), B = curl A, with E = -dA/dt in the steel
# (the plates are isolated, so no scalar potential is needed):
#
#   (sigma dA/dt, A') + (nu(|curl A|) curl A, curl A') = (J_s(t), A')
#
# sigma is 7.505e6 S/m in the steel and zero elsewhere. J_s is the coil current
# from the sub-app team10_coil_source.i, computed once at the peak current and
# scaled here by the time ramp.
#
# Only the eighth x, y, z >= 0 is meshed. x = 0 and y = 0 contain the coil axis and
# carry n x A = 0, as does the far field. z = 0 is the coil mid-plane, where B is
# normal to the plane; that is the natural condition, so it carries no BC here.

peak_current = 5.64 # A
turns = 162
ampere_turns = '${fparse peak_current * turns}' # 913.68 AT at the peak
time_constant = 0.05 # s

conductivity = 7.505e6 # S/m

fe_order = FIRST
flux_order = CONSTANT

mesh_file = team10.e

steel_blocks = 'Plate PlateS1 Channel ChannelS2 ChannelS3'
free_space_blocks = 'Air Coil'

vacuum_permeability = '${fparse 4 * pi * 1e-7}' # H/m
vacuum_reluctivity = '${fparse 1.0 / vacuum_permeability}' # m/H

[Mesh]
  type = MFEMFileMesh
  file = ${mesh_file}
[]

[Problem]
  type = MFEMProblem
[]

[Functions]
  # The time ramp on the coil current, in the two signs the coil kernels take.
  [coil_ramp]
    type = ParsedFunction
    expression = '1 - exp(-t / tau)'
    symbol_names = 'tau'
    symbol_values = '${time_constant}'
  []
  [negative_coil_ramp]
    type = ParsedFunction
    expression = '-(1 - exp(-t / tau))'
    symbol_names = 'tau'
    symbol_values = '${time_constant}'
  []

  # H(B) and dH/dB for the TEAM 10 steel: Table 2 of the problem statement up to
  # 1.8 T, then its Eq. (1). To be generated by an adapted bh_curve.py; do not
  # edit by hand.
  [h_of_b]
    type = MFEMParsedFunction
    expression = 'if(B<0.0025,0+B*(6400+B*(170666.7+B*-6.826667e+07)),if(B<0.005,16+(B-0.0025)*(5973.333+(B-0.0025)*(234666.7+(B-0.0025)*-1.536e+08)),if(B<0.0125,30+(B-0.005)*(4266.667+(B-0.005)*(-279488.4+(B-0.005)*1.830216e+07)),if(B<0.025,54+(B-0.0125)*(3162.83+(B-0.0125)*(42889.55+(B-0.0125)*-3705276)),if(B<0.05,93+(B-0.025)*(2498.221+(B-0.025)*(-13857.65+(B-0.025)*-242847)),if(B<0.1,143+(B-0.05)*(1350+(B-0.05)*(-3254.28+(B-0.05)*-90914.41)),if(B<0.2,191+(B-0.1)*(342.714+(B-0.1)*(-2625.247+(B-0.1)*10981.08)),if(B<0.3,210+(B-0.2)*(147.0968+(B-0.2)*(-489.7616+(B-0.2)*2187.938)),if(B<0.4,222+(B-0.3)*(114.7826+(B-0.3)*(-227.6522+(B-0.3)*1798.261)),if(B<0.5,233+(B-0.4)*(123.2+(B-0.4)*(504+(B-0.4)*-3360)),if(B<0.6,247+(B-0.5)*(123.2+(B-0.5)*(-396+(B-0.5)*2640)),if(B<0.7,258+(B-0.6)*(123.2+(B-0.6)*(200.5161+(B-0.6)*-325.1613)),if(B<0.8,272+(B-0.7)*(153.5484+(B-0.7)*(38.78836+(B-0.7)*1257.278)),if(B<0.9,289+(B-0.8)*(199.0244+(B-0.8)*(593.0971+(B-0.8)*-1833.41)),if(B<1,313+(B-0.9)*(262.6415+(B-0.9)*(275.2948+(B-0.9)*-17.09906)),if(B<1.1,342+(B-1)*(317.1875+(B-1)*(-151.4423+(B-1)*4795.673)),if(B<1.2,377+(B-1.1)*(430.7692+(B-1.1)*(1736.131+(B-1.1)*-4438.228)),if(B<1.3,433+(B-1.2)*(644.8485+(B-1.2)*(76.05356+(B-1.2)*10754.62)),if(B<1.4,509+(B-1.3)*(982.6977+(B-1.3)*(3359.726+(B-1.3)*7132.975)),if(B<1.5,648+(B-1.4)*(1868.632+(B-1.4)*(8144.532+(B-1.4)*16691.48)),if(B<1.55,933+(B-1.5)*(3998.283+(B-1.5)*(27619.14+(B-1.5)*208304.1)),if(B<1.6,1228+(B-1.55)*(8322.478+(B-1.55)*(186147.1+(B-1.55)*-1403932)),if(B<1.65,1934+(B-1.6)*(16407.69+(B-1.6)*(-14052.93+(B-1.6)*1549982)),if(B<1.7,2913+(B-1.65)*(26627.26+(B-1.65)*(576338.8+(B-1.65)*-5537682)),if(B<1.75,4993+(B-1.7)*(42728.53+(B-1.7)*(39885.18+(B-1.7)*-321116.1)),if(B<1.799973,7189+(B-1.75)*(44308.68+(B-1.75)*(-88175.04+(B-1.75)*1922847)),if(B<2.219963,2*(B-1.59)/(2.452664e-05+sqrt(6.015559e-10+-9.524e-10*(B-1.59))),(B-2.158556)/1.256637e-06)))))))))))))))))))))))))))'
    symbol_names = 'B'
    symbol_values = 'a_field_curl_mag'
  []
  [dh_db]
    type = MFEMParsedFunction
    expression = 'if(B<0.0025,6400+B*(341333.3+B*-2.048e+08),if(B<0.005,5973.333+(B-0.0025)*(469333.3+(B-0.0025)*-4.608e+08),if(B<0.0125,4266.667+(B-0.005)*(-558976.9+(B-0.005)*5.490649e+07),if(B<0.025,3162.83+(B-0.0125)*(85779.1+(B-0.0125)*-1.111583e+07),if(B<0.05,2498.221+(B-0.025)*(-27715.3+(B-0.025)*-728540.9),if(B<0.1,1350+(B-0.05)*(-6508.559+(B-0.05)*-272743.2),if(B<0.2,342.714+(B-0.1)*(-5250.495+(B-0.1)*32943.23),if(B<0.3,147.0968+(B-0.2)*(-979.5231+(B-0.2)*6563.815),if(B<0.4,114.7826+(B-0.3)*(-455.3043+(B-0.3)*5394.783),if(B<0.5,123.2+(B-0.4)*(1008+(B-0.4)*-10080),if(B<0.6,123.2+(B-0.5)*(-792+(B-0.5)*7920),if(B<0.7,123.2+(B-0.6)*(401.0323+(B-0.6)*-975.4839),if(B<0.8,153.5484+(B-0.7)*(77.57671+(B-0.7)*3771.833),if(B<0.9,199.0244+(B-0.8)*(1186.194+(B-0.8)*-5500.23),if(B<1,262.6415+(B-0.9)*(550.5896+(B-0.9)*-51.29717),if(B<1.1,317.1875+(B-1)*(-302.8846+(B-1)*14387.02),if(B<1.2,430.7692+(B-1.1)*(3472.261+(B-1.1)*-13314.69),if(B<1.3,644.8485+(B-1.2)*(152.1071+(B-1.2)*32263.85),if(B<1.4,982.6977+(B-1.3)*(6719.452+(B-1.3)*21398.92),if(B<1.5,1868.632+(B-1.4)*(16289.06+(B-1.4)*50074.43),if(B<1.55,3998.283+(B-1.5)*(55238.28+(B-1.5)*624912.3),if(B<1.6,8322.478+(B-1.55)*(372294.1+(B-1.55)*-4211797),if(B<1.65,16407.69+(B-1.6)*(-28105.86+(B-1.6)*4649946),if(B<1.7,26627.26+(B-1.65)*(1152678+(B-1.65)*-1.661305e+07),if(B<1.75,42728.53+(B-1.7)*(79770.36+(B-1.7)*-963348.3),if(B<1.799973,44308.68+(B-1.75)*(-176350.1+(B-1.75)*5768542),if(B<2.219963,1/sqrt(6.015559e-10+-9.524e-10*(B-1.59)),795774.7)))))))))))))))))))))))))))'
    symbol_names = 'B'
    symbol_values = 'a_field_curl_mag'
  []
  # nu = H/B and B dnu/dB, switched to their limits at B -> 0 as in TEAM 20.
  [steel_reluctivity]
    type = MFEMParsedFunction
    expression = 'if(B > 1e-6, h / B, dh)'
    symbol_names = 'h dh B'
    symbol_values = 'h_of_b dh_db a_field_curl_mag'
  []
  [steel_b_dnu_db]
    type = MFEMParsedFunction
    expression = 'if(B > 1e-6, dh - h / B, 0)'
    symbol_names = 'h dh B'
    symbol_values = 'h_of_b dh_db a_field_curl_mag'
  []
[]

[FunctorMaterials]
  [FreeSpace]
    type = MFEMGenericFunctorMaterial
    prop_names = reluctivity
    prop_values = ${vacuum_reluctivity}
    block = ${free_space_blocks}
  []
[]

[FESpaces]
  [HCurlFESpace]
    type = MFEMVectorFESpace
    fec_type = ND
    fec_order = ${fe_order}
  []
  [H1FESpace]
    type = MFEMScalarFESpace
    fec_type = H1
    fec_order = ${fe_order}
  []
  [HDivFESpace]
    type = MFEMVectorFESpace
    fec_type = RT
    fec_order = ${flux_order}
  []
  [L2FESpace]
    type = MFEMScalarFESpace
    fec_type = L2
    fec_order = ${flux_order}
  []
[]

[Variables]
  [a_field]
    type = MFEMVariable
    fespace = HCurlFESpace
  []
[]

[AuxVariables]
  # The coil current at the peak, from the sub-app.
  [applied_current]
    type = MFEMVariable
    fespace = HCurlFESpace
  []
  [correction_potential]
    type = MFEMVariable
    fespace = H1FESpace
  []
  [b_field]
    type = MFEMVariable
    fespace = HDivFESpace
  []
  [b_x]
    type = MFEMVariable
    fespace = L2FESpace
  []
  [b_z]
    type = MFEMVariable
    fespace = L2FESpace
  []
[]

[Kernels]
  # Eddy currents: sigma dA/dt in the steel only.
  [eddy_current]
    type = MFEMTimeDerivativeVectorFEMassKernel
    variable = a_field
    coefficient = ${conductivity}
    block = ${steel_blocks}
  []
  # Removes the gradient null space in the non-conducting regions, as in TEAM 20.
  [regularisation]
    type = MFEMVectorFEMassKernel
    variable = a_field
    coefficient = 1e2
  []
  [curl_curl_free_space]
    type = MFEMCurlCurlKernel
    variable = a_field
    coefficient = reluctivity
    block = ${free_space_blocks}
  []
  [curl_curl_steel]
    type = MFEMNLCurlCurlKernel
    variable = a_field
    k_coefficient = steel_reluctivity
    curlu_dk_dcurlu_coefficient = steel_b_dnu_db
    block = ${steel_blocks}
  []
  # J = ramp(t) (J_applied - grad(phi)), on the left hand side so signs flipped.
  [coil_current]
    type = MFEMMixedVectorMassKernel
    variable = a_field
    trial_variable = applied_current
    coefficient = negative_coil_ramp
    block = 'Coil'
  []
  [coil_current_correction]
    type = MFEMMixedVectorGradientKernel
    variable = a_field
    trial_variable = correction_potential
    coefficient = coil_ramp
  []
[]

[BCs]
  # symmetry_z is deliberately absent: it carries the natural condition.
  [tangential_a_zero]
    type = MFEMVectorTangentialDirichletBC
    variable = a_field
    vector_coefficient = '0 0 0'
    boundary = 'far_field symmetry_x symmetry_y'
  []
[]

[AuxKernels]
  [update_b_field]
    type = MFEMCurlAux
    variable = b_field
    source = a_field
  []
  [update_b_x]
    type = MFEMInnerProductAux
    variable = b_x
    first_source_vec = a_field_curl
    second_source_vec = '1 0 0'
  []
  [update_b_z]
    type = MFEMInnerProductAux
    variable = b_z
    first_source_vec = a_field_curl
    second_source_vec = '0 0 1'
  []
[]

[Solvers]
  [ams]
    type = MFEMHypreAMS
    fespace = HCurlFESpace
    singular = false
  []
  [pcg]
    type = MFEMHyprePCG
    preconditioner = ams
    l_tol = 1e-10
    l_max_its = 500
    print_level = 0
  []
  [newton]
    type = MFEMNewtonNonlinearSolver
    max_its = 50
    abs_tol = 1e-8
    rel_tol = 1e-7
    print_level = 1
    line_search = backtracking
  []
[]

[MultiApps]
  [coil_source]
    type = FullSolveMultiApp
    input_files = team10_coil_source.i
    cli_args = 'ampere_turns=${ampere_turns};fe_order=${fe_order};mesh_file=${mesh_file}'
    execute_on = INITIAL
  []
[]

[Transfers]
  [from_coil_source]
    type = MultiAppMFEMCopyTransfer
    source_variables = 'applied_current correction_potential'
    variables = 'applied_current correction_potential'
    from_multi_app = coil_source
  []
[]

[Executioner]
  type = MFEMTransient
  device = cpu
  start_time = 0.0
  end_time = 0.12 # s; check against the span of the measured curves
  dt = 1e-3 # s; tau = 0.05 s, so the ramp is resolved, but check convergence
[]

[Postprocessors]
  # Fig. 2: average flux density through the three sections, each taken over a
  # thin band of steel with a block of its own. Averages need no symmetry factor.
  # The flux runs up the plate, out along the flange and down the web, so B3 is
  # negative with this coil direction.
  [B1]
    type = MFEMElementAverageValue
    variable = b_z
    block = 'PlateS1'
  []
  [B2]
    type = MFEMElementAverageValue
    variable = b_x
    block = 'ChannelS2'
  []
  [B3]
    type = MFEMElementAverageValue
    variable = b_z
    block = 'ChannelS3'
  []
[]

[Outputs]
  [ReportedPostprocessors]
    type = CSV
    file_base = OutputData/TEAM10CSV
  []
  [ParaViewDataCollection]
    type = MFEMParaViewDataCollection
    file_base = OutputData/TEAM10
  []
[]
